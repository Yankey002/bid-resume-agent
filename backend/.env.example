# 大模型配置
# 模型类型: openai, deepseek, zhipu
LLM_TYPE=deepseek

# OpenAI 配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=1000

# DeepSeek 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_MAX_TOKENS=1000

# 智谱清言配置
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_MODEL=glm-4
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_TEMPERATURE=0.1
ZHIPU_MAX_TOKENS=1000

# 本机 Postgres（默认 docker: postgres:16）
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/resume_pilot

# JWT
JWT_SECRET_KEY=change_me_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXP_MINUTES=720

# 存储目录（原始简历）
RAW_RESUME_DIR=./storage/raw_resumes

# 管理员初始化（首次启动自动创建）
ADMIN_EMAIL=admin@qishirecord.cn
ADMIN_PASSWORD=yanky430

# 部署配置 (CI/CD 使用)
# SSH_HOST=
# SSH_USER=
# SSH_PRIVATE_KEY=
# SSH_PORT=22
